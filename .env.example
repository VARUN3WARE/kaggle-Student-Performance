## Example environment file for docker-compose.mlflow.yml
# Copy to .env and edit values before `docker compose -f docker-compose.mlflow.yml up -d`

# MinIO credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Postgres for MLflow backend
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflowpwd
POSTGRES_DB=mlflow
